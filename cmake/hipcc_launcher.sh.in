#!/bin/sh
# Generated by Quinoa CMake configuration. Do not edit this build-tree copy.
# Used as both compiler and link driver for the offloaded targets. hipcc is a
# complete compiler, but calling it directly loses the include and link flags
# the MPI wrapper contributes -- mpi.h in particular, which Trilinos headers
# need. So exec the wrapper and point its underlying compiler at hipcc, the
# same mechanism the TPL build uses for Trilinos. All four variables are set
# because MPI detection does not reliably report which language a given
# wrapper serves.
OMPI_CXX="@QUINOA_HIP_COMPILER@"
OMPI_CC="@QUINOA_HIP_COMPILER@"
MPICH_CXX="@QUINOA_HIP_COMPILER@"
MPICH_CC="@QUINOA_HIP_COMPILER@"
export OMPI_CXX OMPI_CC MPICH_CXX MPICH_CC
# @QUINOA_GCC_TOOLCHAIN_FLAG@ must be here rather than only in the targets'
# compile options: charmc drives the final link through this same script, and
# without the pin on the link line clang resolves libstdc++ from whichever GCC
# it picks first, which shows up as undefined GLIBCXX_3.4.2x symbols.
exec "@MPI_CXX_COMPILER@" @QUINOA_GCC_TOOLCHAIN_FLAG@ "$@"
