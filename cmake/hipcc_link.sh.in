#!/bin/sh
# Generated by Quinoa CMake configuration. Do not edit this build-tree copy.
# Link driver handed to charmc via -ld++. The MPI wrapper contributes the MPI
# libraries that Charm++'s machine layer needs; hipcc, dispatched to by the
# wrapper, contributes the HIP runtime. --gcc-toolchain pins libstdc++ to the
# same GCC installation the host-only objects were compiled against.
OMPI_CXX="@QUINOA_HIP_COMPILER@"
OMPI_CC="@QUINOA_HIP_COMPILER@"
MPICH_CXX="@QUINOA_HIP_COMPILER@"
MPICH_CC="@QUINOA_HIP_COMPILER@"
export OMPI_CXX OMPI_CC MPICH_CXX MPICH_CC
exec "@MPI_CXX_COMPILER@" @QUINOA_GCC_TOOLCHAIN_FLAG@ "$@"
